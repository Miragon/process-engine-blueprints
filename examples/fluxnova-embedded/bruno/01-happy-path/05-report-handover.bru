meta {
  name: Report the handover
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/api/bike-leasing/{{applicationId}}/report-handover
  body: none
  auth: none
}

script:pre-request {
  await pollApp("/api/bike-leasing/" + bru.getVar("applicationId"),
    (b, s) => s === 200 && b && b.status === "ORDERED" && b.orderId != null);
  await pollMessageSubscription(bru.getVar("applicationId"), "miravelo.handoverReported");
}

assert {
  res.status: eq 202
}
