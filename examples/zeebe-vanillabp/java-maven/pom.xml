<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.1</version>
        <relativePath/>
    </parent>

    <groupId>io.miragon.blueprint</groupId>
    <artifactId>zeebe-example</artifactId>
    <version>1.0-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>zeebe-example</name>
    <description>Headless MiraVelo bike-leasing blueprint on Camunda 8 / Zeebe, bound through VanillaBP</description>

    <modules>
        <module>service/common-architecture-tests</module>
        <module>service/common-zeebe</module>
        <module>service/common-zeebe-test</module>
        <module>service/app</module>
    </modules>

    <properties>
        <java.version>21</java.version>
        <maven.compiler.release>21</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <!-- Third-party versions not managed by the Spring Boot BOM -->
        <!-- The client line the VanillaBP Camunda 8 adapter 1.10.0 is built against; 8.9 clients break it -->
        <zeebe.version>8.8.39</zeebe.version>
        <vanillabp-spi.version>1.1.0</vanillabp-spi.version>
        <vanillabp-camunda8-adapter.version>1.10.0</vanillabp-camunda8-adapter.version>
        <springdoc.version>3.1.1</springdoc.version>
        <bpmn-to-code.version>6.6.1</bpmn-to-code.version>
        <archunit.version>1.5.1</archunit.version>
        <testcontainers.version>2.0.5</testcontainers.version>
        <postgresql.version>42.7.13</postgresql.version>
        <h2.version>2.5.252</h2.version>

        <!-- Build plugins -->
        <checkstyle.version>10.21.1</checkstyle.version>
        <maven-checkstyle-plugin.version>3.6.0</maven-checkstyle-plugin.version>
        <pitest-maven.version>1.19.0</pitest-maven.version>
        <pitest-junit5-plugin.version>1.2.2</pitest-junit5-plugin.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- Camunda 8 / Zeebe -->
            <dependency>
                <groupId>io.camunda</groupId>
                <artifactId>camunda-spring-boot-4-starter</artifactId>
                <version>${zeebe.version}</version>
            </dependency>
            <dependency>
                <groupId>io.camunda</groupId>
                <artifactId>camunda-process-test-spring-4</artifactId>
                <version>${zeebe.version}</version>
            </dependency>

            <!-- VanillaBP — the application compiles against the SPI only; the Camunda 8 adapter is a runtime concern -->
            <dependency>
                <groupId>io.vanillabp</groupId>
                <artifactId>spi-for-java</artifactId>
                <version>${vanillabp-spi.version}</version>
            </dependency>
            <dependency>
                <groupId>org.camunda.community.vanillabp</groupId>
                <artifactId>camunda8-spring-boot-adapter</artifactId>
                <version>${vanillabp-camunda8-adapter.version}</version>
            </dependency>

            <!-- OpenAPI — springdoc (3.x = the Spring Boot 4 line) -->
            <dependency>
                <groupId>org.springdoc</groupId>
                <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
                <version>${springdoc.version}</version>
            </dependency>

            <!-- bpmn-to-code — runtime consumed by the generated process API; testing = model validation -->
            <dependency>
                <groupId>io.miragon</groupId>
                <artifactId>bpmn-to-code-runtime</artifactId>
                <version>${bpmn-to-code.version}</version>
            </dependency>
            <dependency>
                <groupId>io.miragon</groupId>
                <artifactId>bpmn-to-code-testing</artifactId>
                <version>${bpmn-to-code.version}</version>
            </dependency>

            <!-- Architecture tests -->
            <dependency>
                <groupId>com.tngtech.archunit</groupId>
                <artifactId>archunit</artifactId>
                <version>${archunit.version}</version>
            </dependency>

            <!-- Persistence drivers (pinned; overrides the BOM-managed versions) -->
            <dependency>
                <groupId>org.postgresql</groupId>
                <artifactId>postgresql</artifactId>
                <version>${postgresql.version}</version>
            </dependency>
            <dependency>
                <groupId>com.h2database</groupId>
                <artifactId>h2</artifactId>
                <version>${h2.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <!-- bpmn-to-code: generates the typed process API (Java) from the *.bpmn models -->
                <plugin>
                    <groupId>io.miragon</groupId>
                    <artifactId>bpmn-to-code-maven</artifactId>
                    <version>${bpmn-to-code.version}</version>
                </plugin>

                <!-- Checkstyle: preserves the two source-structure guidelines Konsist enforces in the
                     Kotlin variant (no wildcard imports, one top-level type per file). See docs/adr/0007. -->
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-checkstyle-plugin</artifactId>
                    <version>${maven-checkstyle-plugin.version}</version>
                    <dependencies>
                        <dependency>
                            <groupId>com.puppycrawl.tools</groupId>
                            <artifactId>checkstyle</artifactId>
                            <version>${checkstyle.version}</version>
                        </dependency>
                    </dependencies>
                </plugin>

                <!-- PIT mutation testing (gate 80). See docs/adr/0004. -->
                <plugin>
                    <groupId>org.pitest</groupId>
                    <artifactId>pitest-maven</artifactId>
                    <version>${pitest-maven.version}</version>
                    <dependencies>
                        <dependency>
                            <groupId>org.pitest</groupId>
                            <artifactId>pitest-junit5-plugin</artifactId>
                            <version>${pitest-junit5-plugin.version}</version>
                        </dependency>
                    </dependencies>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>
</project>
