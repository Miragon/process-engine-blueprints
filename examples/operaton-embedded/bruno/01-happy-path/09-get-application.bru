meta {
  name: Get the leasing application after leasing is active
  type: http
  seq: 9
}

get {
  url: {{baseUrl}}/api/bike-leasing/{{applicationId}}
  body: none
  auth: none
}

script:pre-request {
  const id = bru.getVar("applicationId");
  await pollApp(`/api/bike-leasing/${id}`, (b, s) => s === 200 && b && b.status === "ACTIVE");
}

assert {
  res.status: eq 200
  res.body.applicationId: eq {{applicationId}}
  res.body.status: eq ACTIVE
  res.body.bikeModel: eq Gravel Explorer 900
}
