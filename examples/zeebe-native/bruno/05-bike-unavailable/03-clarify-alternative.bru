meta {
  name: Clarify an alternative bike
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/api/bike-leasing/{{applicationId}}/clarify-alternative
  body: json
  auth: none
}

body:json {
  {
    "alternativeFound": true,
    "bikeId": "BIKE-901",
    "bikeModel": "Gravel Explorer 901"
  }
}

script:pre-request {
  const id = bru.getVar("applicationId");
  await pollApp("/api/tasks/clarify-alternative",
    (b) => Array.isArray(b) && b.some((t) => t.applicationId === id));
}

assert {
  res.status: eq 202
}

docs {
  This endpoint registers the chosen bike's model in the portfolio and completes the
  user task with the bikeId. The re-order reads that variable and persists it on the
  aggregate.
}
