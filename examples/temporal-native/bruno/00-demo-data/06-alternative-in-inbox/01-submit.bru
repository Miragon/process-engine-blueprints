meta {
  name: Submit leasing request
  type: http
  seq: 1
  tags: [
    demo-data
  ]
}

post {
  url: {{baseUrl}}/api/bike-leasing
  body: json
  auth: none
}

body:json {
  {
    "customerName": "Lena Restock",
    "email": "lena@example.com",
    "age": 33,
    "monthlyNetIncome": 3500.0,
    "bikeId": "BIKE-OOS",
    "bikeModel": "Limited Edition (out of stock)"
  }
}

assert {
  res.status: eq 200
  res.body.applicationId: isDefined
}

vars:post-response {
  applicationId: res.body.applicationId
}
