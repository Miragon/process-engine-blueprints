<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.0</version>
        <relativePath/>
    </parent>

    <groupId>io.miragon.blueprint</groupId>
    <artifactId>operaton-remote-example</artifactId>
    <version>1.0-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>operaton-remote-example</name>
    <description>Headless MiraVelo bike-leasing blueprint on a remote Operaton engine (external tasks)</description>

    <!-- Reactor order: the two shared modules first, then the two Spring Boot apps that consume them. -->
    <modules>
        <module>service/common-architecture-tests</module>
        <module>service/common-operaton-client</module>
        <module>service/engine-service</module>
        <module>service/example-service</module>
    </modules>

    <properties>
        <java.version>21</java.version>
        <maven.compiler.release>21</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <!-- Third-party versions not managed by the Spring Boot BOM -->
        <operaton.version>2.1.3</operaton.version>
        <springdoc.version>3.1.0</springdoc.version>
        <bpmn-to-code.version>5.2.0</bpmn-to-code.version>
        <archunit.version>1.5.0</archunit.version>
        <postgresql.version>42.7.13</postgresql.version>
        <h2.version>2.4.240</h2.version>
        <jakarta-annotation.version>3.0.0</jakarta-annotation.version>
        <jakarta-xml-bind.version>4.0.5</jakarta-xml-bind.version>
        <jaxb-runtime.version>4.0.9</jaxb-runtime.version>

        <!-- Build plugins -->
        <openapi-generator.version>7.24.0</openapi-generator.version>
        <maven-dependency-plugin.version>3.8.1</maven-dependency-plugin.version>
        <checkstyle.version>10.21.1</checkstyle.version>
        <maven-checkstyle-plugin.version>3.6.0</maven-checkstyle-plugin.version>
        <pitest-maven.version>1.19.0</pitest-maven.version>
        <pitest-junit5-plugin.version>1.2.2</pitest-junit5-plugin.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- Operaton (Camunda 7 fork) — the platform is versioned as a whole (2.x = Spring Boot 4). -->
            <dependency>
                <groupId>org.operaton.bpm.springboot</groupId>
                <artifactId>operaton-bpm-spring-boot-starter-webapp</artifactId>
                <version>${operaton.version}</version>
            </dependency>
            <dependency>
                <groupId>org.operaton.bpm.springboot</groupId>
                <artifactId>operaton-bpm-spring-boot-starter-rest</artifactId>
                <version>${operaton.version}</version>
            </dependency>
            <dependency>
                <groupId>org.operaton.bpm.springboot</groupId>
                <artifactId>operaton-bpm-spring-boot-starter-external-task-client</artifactId>
                <version>${operaton.version}</version>
            </dependency>
            <!-- Official engine REST OpenAPI document — consumed only as generator input by common-operaton-client. -->
            <dependency>
                <groupId>org.operaton.bpm</groupId>
                <artifactId>operaton-engine-rest-openapi</artifactId>
                <version>${operaton.version}</version>
            </dependency>
            <!-- Standalone in-memory engine + process-test support for the worker's own process tests. -->
            <dependency>
                <groupId>org.operaton.bpm</groupId>
                <artifactId>operaton-bpm-assert</artifactId>
                <version>${operaton.version}</version>
            </dependency>
            <dependency>
                <groupId>org.operaton.bpm</groupId>
                <artifactId>operaton-bpm-junit5</artifactId>
                <version>${operaton.version}</version>
            </dependency>
            <dependency>
                <groupId>org.operaton.bpm</groupId>
                <artifactId>operaton-engine</artifactId>
                <version>${operaton.version}</version>
            </dependency>

            <!-- OpenAPI — springdoc (3.x = the Spring Boot 4 line) -->
            <dependency>
                <groupId>org.springdoc</groupId>
                <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
                <version>${springdoc.version}</version>
            </dependency>

            <!-- bpmn-to-code — runtime consumed by the generated process API; testing = model validation -->
            <dependency>
                <groupId>io.miragon</groupId>
                <artifactId>bpmn-to-code-runtime</artifactId>
                <version>${bpmn-to-code.version}</version>
            </dependency>
            <dependency>
                <groupId>io.miragon</groupId>
                <artifactId>bpmn-to-code-testing</artifactId>
                <version>${bpmn-to-code.version}</version>
            </dependency>

            <!-- Architecture tests -->
            <dependency>
                <groupId>com.tngtech.archunit</groupId>
                <artifactId>archunit</artifactId>
                <version>${archunit.version}</version>
            </dependency>

            <!-- Jakarta annotations — referenced by the generated engine client (@jakarta.annotation.*). -->
            <dependency>
                <groupId>jakarta.annotation</groupId>
                <artifactId>jakarta.annotation-api</artifactId>
                <version>${jakarta-annotation.version}</version>
            </dependency>
            <!-- JAXB — the external-task client (de)serializes typed variables via JAXB. -->
            <dependency>
                <groupId>jakarta.xml.bind</groupId>
                <artifactId>jakarta.xml.bind-api</artifactId>
                <version>${jakarta-xml-bind.version}</version>
            </dependency>
            <dependency>
                <groupId>org.glassfish.jaxb</groupId>
                <artifactId>jaxb-runtime</artifactId>
                <version>${jaxb-runtime.version}</version>
            </dependency>

            <!-- Persistence drivers (pinned; override the BOM-managed versions) -->
            <dependency>
                <groupId>org.postgresql</groupId>
                <artifactId>postgresql</artifactId>
                <version>${postgresql.version}</version>
            </dependency>
            <dependency>
                <groupId>com.h2database</groupId>
                <artifactId>h2</artifactId>
                <version>${h2.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <!-- OpenAPI Generator: builds the typed /engine-rest client (Java) in common-operaton-client. -->
                <plugin>
                    <groupId>org.openapitools</groupId>
                    <artifactId>openapi-generator-maven-plugin</artifactId>
                    <version>${openapi-generator.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-dependency-plugin</artifactId>
                    <version>${maven-dependency-plugin.version}</version>
                </plugin>

                <!-- bpmn-to-code: generates the typed process API (Java) from the *.bpmn models. -->
                <plugin>
                    <groupId>io.miragon</groupId>
                    <artifactId>bpmn-to-code-maven</artifactId>
                    <version>${bpmn-to-code.version}</version>
                </plugin>

                <!-- Checkstyle: the two source-structure guidelines Konsist used to enforce
                     (no wildcard imports, one top-level type per file). See docs/adr/0007. -->
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-checkstyle-plugin</artifactId>
                    <version>${maven-checkstyle-plugin.version}</version>
                    <dependencies>
                        <dependency>
                            <groupId>com.puppycrawl.tools</groupId>
                            <artifactId>checkstyle</artifactId>
                            <version>${checkstyle.version}</version>
                        </dependency>
                    </dependencies>
                </plugin>

                <!-- PIT mutation testing (gate 80). See docs/adr/0004. -->
                <plugin>
                    <groupId>org.pitest</groupId>
                    <artifactId>pitest-maven</artifactId>
                    <version>${pitest-maven.version}</version>
                    <dependencies>
                        <dependency>
                            <groupId>org.pitest</groupId>
                            <artifactId>pitest-junit5-plugin</artifactId>
                            <version>${pitest-junit5-plugin.version}</version>
                        </dependency>
                    </dependencies>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>
</project>
