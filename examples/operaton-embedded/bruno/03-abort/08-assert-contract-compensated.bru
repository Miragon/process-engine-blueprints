meta {
  name: Assert the contract was compensated
  type: http
  seq: 8
}

get {
  url: {{engineRest}}/history/activity-instance?processInstanceId={{processInstanceId}}&activityId=serviceTask_cancelContract
  body: none
  auth: none
}

script:pre-request {
  const pid = bru.getVar("processInstanceId");
  await pollEngine(`/history/activity-instance?processInstanceId=${pid}&activityId=serviceTask_cancelContract`,
    (b, s) => s === 200 && Array.isArray(b) && b.length >= 1);
}

assert {
  res.status: eq 200
  res.body[0].id: isDefined
}
