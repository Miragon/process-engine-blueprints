meta {
  name: Assert the application is WITHDRAWN
  type: http
  seq: 5
  tags: [
    demo-data
  ]
}

get {
  url: {{baseUrl}}/api/bike-leasing/{{applicationId}}
  body: none
  auth: none
}

script:pre-request {
  await pollApp("/api/bike-leasing/" + bru.getVar("applicationId"),
    (b, s) => s === 200 && b && b.status === "WITHDRAWN");
}

assert {
  res.status: eq 200
  res.body.status: eq WITHDRAWN
}
