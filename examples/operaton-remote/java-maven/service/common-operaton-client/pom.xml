<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.miragon.blueprint</groupId>
        <artifactId>operaton-remote-example</artifactId>
        <version>1.0-SNAPSHOT</version>
        <relativePath>../../pom.xml</relativePath>
    </parent>

    <artifactId>common-operaton-client</artifactId>
    <name>common-operaton-client</name>
    <description>
        Autogenerated Operaton engine REST client (Java). Generated from Operaton's official OpenAPI
        document, which ships (as openapi.json) inside the operaton-engine-rest-openapi artifact, pinned
        to the engine version so client and engine never drift. Nothing generated is committed — it is a
        build artifact under target/. The worker (example-service) drives the engine through this client
        instead of hand-written HTTP calls.
    </description>

    <!-- Compile-scope so the generated client's dependencies reach the consuming worker transitively. -->
    <dependencies>
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-web</artifactId>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.datatype</groupId>
            <artifactId>jackson-datatype-jsr310</artifactId>
        </dependency>
        <dependency>
            <groupId>jakarta.annotation</groupId>
            <artifactId>jakarta.annotation-api</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- 1. Extract the bundled openapi.json from the pinned operaton-engine-rest-openapi jar. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <executions>
                    <execution>
                        <id>extract-openapi-spec</id>
                        <phase>initialize</phase>
                        <goals>
                            <goal>unpack</goal>
                        </goals>
                        <configuration>
                            <artifactItems>
                                <artifactItem>
                                    <groupId>org.operaton.bpm</groupId>
                                    <artifactId>operaton-engine-rest-openapi</artifactId>
                                    <version>${operaton.version}</version>
                                    <includes>**/openapi.json</includes>
                                    <outputDirectory>${project.build.directory}/openapi-spec</outputDirectory>
                                </artifactItem>
                            </artifactItems>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!-- 2. Generate the typed Java client (Spring RestClient library, matching the worker's RestClient). -->
            <plugin>
                <groupId>org.openapitools</groupId>
                <artifactId>openapi-generator-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>generate-engine-client</id>
                        <phase>generate-sources</phase>
                        <goals>
                            <goal>generate</goal>
                        </goals>
                        <configuration>
                            <generatorName>java</generatorName>
                            <library>restclient</library>
                            <inputSpec>${project.build.directory}/openapi-spec/openapi.json</inputSpec>
                            <output>${project.build.directory}/generated-sources/openapi</output>
                            <invokerPackage>org.operaton.rest.client</invokerPackage>
                            <apiPackage>org.operaton.rest.client.api</apiPackage>
                            <modelPackage>org.operaton.rest.client.model</modelPackage>
                            <validateSpec>false</validateSpec>
                            <generateApiTests>false</generateApiTests>
                            <generateModelTests>false</generateModelTests>
                            <generateApiDocumentation>false</generateApiDocumentation>
                            <generateModelDocumentation>false</generateModelDocumentation>
                            <configOptions>
                                <useJakartaEe>true</useJakartaEe>
                                <serializationLibrary>jackson</serializationLibrary>
                                <openApiNullable>false</openApiNullable>
                                <useBeanValidation>false</useBeanValidation>
                                <hideGenerationTimestamp>true</hideGenerationTimestamp>
                            </configOptions>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
