meta {
  name: Clarify an acceptable alternative bike
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/api/bike-leasing/{{applicationId}}/clarify-alternative
  body: json
  auth: none
}

body:json {
  {
    "alternativeFound": true,
    "bikeId": "BIKE-901",
    "bikeModel": "Gravel Explorer 901"
  }
}

script:pre-request {
  const id = bru.getVar("applicationId");
  await pollApp("/api/tasks/clarify-alternative",
    (b) => Array.isArray(b) && b.some((t) => t.applicationId === id));
  await pollSearch("/user-tasks/search",
    { filter: { elementId: "userTask_clarifyAlternative", state: "CREATED",
      processInstanceVariables: [{ name: "applicationId", value: `"${id}"` }] } },
    (b) => b && Array.isArray(b.items) && b.items.length > 0);
}

assert {
  res.status: eq 202
}

docs {
  The recommended, domain-routed completion path: this endpoint persists the chosen
  alternative on the aggregate before completing the user task, so the captured data
  reaches the domain model.

  The inbox lists the case as soon as VanillaBP has reported the user task to the
  workflow aggregate. VanillaBP only completes a task Camunda's search already knows,
  and that index trails by a moment, so the request also waits for the engine to list
  the task; completing earlier is rolled back and answered with a 500.
}
