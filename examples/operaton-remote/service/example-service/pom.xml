<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.miragon.blueprint</groupId>
        <artifactId>operaton-remote-example</artifactId>
        <version>1.0-SNAPSHOT</version>
        <relativePath>../../pom.xml</relativePath>
    </parent>

    <artifactId>example-service</artifactId>
    <name>example-service</name>
    <description>
        The remote worker + business logic (hexagonal), and — since there is no separate contract
        module — the owner of the process contract too. It carries the .bpmn/.dmn/.form models, generates
        the typed *ProcessApi from them with bpmn-to-code, keeps its own JPA/Postgres store, subscribes to
        the engine's external service-tasks via the Operaton external-task client, deploys the model into
        the remote engine over REST at start-up, and drives the running process with the generated client.
    </description>

    <dependencies>
        <!-- Generated Operaton engine REST client (this repo's sibling module) -->
        <dependency>
            <groupId>io.miragon.blueprint</groupId>
            <artifactId>common-operaton-client</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- bpmn-to-code runtime — types referenced by the generated process API -->
        <dependency>
            <groupId>io.miragon</groupId>
            <artifactId>bpmn-to-code-runtime</artifactId>
        </dependency>

        <!-- Web + observability -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-registry-prometheus</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-devtools</artifactId>
            <scope>runtime</scope>
            <optional>true</optional>
        </dependency>

        <!-- Persistence -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-flyway</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
        </dependency>

        <!-- Operaton external-task client — fetch/lock/complete the engine's external service-tasks -->
        <dependency>
            <groupId>org.operaton.bpm.springboot</groupId>
            <artifactId>operaton-bpm-spring-boot-starter-external-task-client</artifactId>
        </dependency>
        <!-- JAXB — the external-task client (de)serializes typed variables via JAXB -->
        <dependency>
            <groupId>jakarta.xml.bind</groupId>
            <artifactId>jakarta.xml.bind-api</artifactId>
        </dependency>
        <dependency>
            <groupId>org.glassfish.jaxb</groupId>
            <artifactId>jaxb-runtime</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- OpenAPI contract (served at /v3/api-docs + Swagger UI) -->
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
        </dependency>

        <!-- ================= test ================= -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-webmvc-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- Standalone in-memory engine for the worker's own process-model behaviour test -->
        <dependency>
            <groupId>org.operaton.bpm</groupId>
            <artifactId>operaton-bpm-assert</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.operaton.bpm</groupId>
            <artifactId>operaton-bpm-junit5</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.operaton.bpm</groupId>
            <artifactId>operaton-engine</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- Structural BPMN model validation (build-time, no engine) -->
        <dependency>
            <groupId>io.miragon</groupId>
            <artifactId>bpmn-to-code-testing</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- Reusable ArchUnit rule suite -->
        <dependency>
            <groupId>io.miragon.blueprint</groupId>
            <artifactId>common-architecture-tests</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- Generate the typed process API (Java) from the *.bpmn models into src/main/java.
                 Mirrors the Gradle generateBpmnModels task. Never hand-edit process/*. -->
            <plugin>
                <groupId>io.miragon</groupId>
                <artifactId>bpmn-to-code-maven</artifactId>
                <executions>
                    <execution>
                        <id>generate-bpmn-api</id>
                        <phase>generate-sources</phase>
                        <goals>
                            <goal>generate-bpmn-api</goal>
                        </goals>
                    </execution>
                </executions>
                <configuration>
                    <baseDir>${project.basedir}</baseDir>
                    <filePattern>src/main/resources/bpmn/*.bpmn</filePattern>
                    <outputFolderPath>${project.basedir}/src/main/java</outputFolderPath>
                    <packagePath>io.miragon.blueprint.process</packagePath>
                    <outputLanguage>JAVA</outputLanguage>
                    <processEngine>CAMUNDA_7</processEngine>
                </configuration>
            </plugin>

            <!-- Checkstyle: no wildcard imports + one top-level type per file (Konsist's source rules). -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-checkstyle-plugin</artifactId>
                <configuration>
                    <configLocation>${maven.multiModuleProjectDirectory}/config/checkstyle/checkstyle.xml</configLocation>
                    <includeTestSourceDirectory>true</includeTestSourceDirectory>
                    <failOnViolation>true</failOnViolation>
                    <violationSeverity>warning</violationSeverity>
                    <!-- process is generated; do not lint it -->
                    <excludes>io/miragon/blueprint/process/**/*</excludes>
                </configuration>
                <executions>
                    <execution>
                        <id>checkstyle-check</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>check</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

            <!-- Fork a fresh JVM per test class — mirrors Gradle forkEvery=1 so the standalone in-memory
                 engine used by the process tests never carries state between classes. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <reuseForks>false</reuseForks>
                    <forkCount>1</forkCount>
                </configuration>
            </plugin>

            <!-- Spring Boot: repackage, build-info, and the OCI image (miravelo/example-service). -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <image>
                        <name>miravelo/example-service:${project.version}</name>
                        <env>
                            <BP_JVM_VERSION>21</BP_JVM_VERSION>
                        </env>
                    </image>
                </configuration>
                <executions>
                    <execution>
                        <goals>
                            <goal>build-info</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

            <!-- PIT mutation testing configuration (run: mvn -pl service/example-service pitest:mutationCoverage). -->
            <plugin>
                <groupId>org.pitest</groupId>
                <artifactId>pitest-maven</artifactId>
                <configuration>
                    <targetTests>
                        <param>io.miragon.blueprint.*</param>
                    </targetTests>
                    <excludedClasses>
                        <!-- Generated typed process API — no behaviour of ours to mutate. -->
                        <param>io.miragon.blueprint.process.*ProcessApi*</param>
                        <!-- Application bootstrap / wiring, outside the hexagonal layers. -->
                        <param>io.miragon.blueprint.ExampleServiceApplication*</param>
                        <param>io.miragon.blueprint.BikeCatalogueSeeder*</param>
                        <param>io.miragon.blueprint.adapter.inbound.rest.DevCorsConfiguration*</param>
                        <!-- Remote engine plumbing — external-task workers and the start-up deployment
                             adapter are integration glue, exercised by the process / Bruno layers. -->
                        <param>io.miragon.blueprint.adapter.inbound.operaton.*</param>
                        <param>io.miragon.blueprint.adapter.outbound.engine.ProcessModelDeploymentAdapter*</param>
                    </excludedClasses>
                    <excludedTestClasses>
                        <param>io.miragon.blueprint.process.*</param>
                        <param>io.miragon.blueprint.architecture.*</param>
                    </excludedTestClasses>
                    <avoidCallsTo>
                        <avoidCallsTo>org.slf4j</avoidCallsTo>
                    </avoidCallsTo>
                    <mutators>
                        <mutator>DEFAULTS</mutator>
                    </mutators>
                    <outputFormats>
                        <param>HTML</param>
                        <param>XML</param>
                    </outputFormats>
                    <timestampedReports>false</timestampedReports>
                    <timeoutFactor>2.0</timeoutFactor>
                    <threads>4</threads>
                    <mutationThreshold>80</mutationThreshold>
                    <failWhenNoMutations>false</failWhenNoMutations>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!-- Full-module mutation sweep (nightly + local). Active unless a CLI profile overrides it. -->
        <profile>
            <id>pit-full</id>
            <activation>
                <activeByDefault>true</activeByDefault>
            </activation>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.pitest</groupId>
                        <artifactId>pitest-maven</artifactId>
                        <configuration>
                            <targetClasses>
                                <param>io.miragon.blueprint.*</param>
                            </targetClasses>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
        <!-- Diff-scoped mutation (PR gate): CI passes -DtargetClasses="a.*,b.*". -->
        <profile>
            <id>pit-diff</id>
        </profile>
    </profiles>
</project>
