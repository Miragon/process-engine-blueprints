meta {
  name: Submit leasing request
  type: http
  seq: 1
  tags: [
    demo-data
  ]
}

post {
  url: {{baseUrl}}/api/bike-leasing
  body: json
  auth: none
}

body:json {
  {
    "customerName": "Ida Handover",
    "email": "ida@example.com",
    "age": 29,
    "monthlyNetIncome": 3500.0,
    "bikeId": "BIKE-900",
    "bikeModel": "Gravel Explorer 900"
  }
}

assert {
  res.status: eq 200
  res.body.applicationId: isDefined
}

vars:post-response {
  applicationId: res.body.applicationId
}
