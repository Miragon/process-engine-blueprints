meta {
  name: Withdraw the application
  type: http
  seq: 4
  tags: [
    demo-data
  ]
}

post {
  url: {{baseUrl}}/api/bike-leasing/{{applicationId}}/withdraw
  body: none
  auth: none
}

script:pre-request {
  await pollApp("/api/bike-leasing/" + bru.getVar("applicationId"),
    (b, s) => s === 200 && b && b.status === "ORDERED" && b.orderId != null);
  await pollMessageSubscription(bru.getVar("applicationId"), "miravelo.handoverReported");
  await pollEngine("/job?processInstanceId=" + bru.getVar("processInstanceId") + "&messages=true",
    (b) => Array.isArray(b) && b.length === 0);
}

assert {
  res.status: eq 202
}
