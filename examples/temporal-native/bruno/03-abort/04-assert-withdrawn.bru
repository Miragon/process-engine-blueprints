meta {
  name: Application stays withdrawn until the return is clarified
  type: http
  seq: 4
}

get {
  url: {{baseUrl}}/api/bike-leasing/{{applicationId}}
  body: none
  auth: none
}

script:pre-request {
  const id = bru.getVar("applicationId");
  await pollApp(`/api/bike-leasing/${id}`, (b, s) => s === 200 && b && b.status === "WITHDRAWN");
}

assert {
  res.status: eq 200
  res.body.status: eq WITHDRAWN
}
