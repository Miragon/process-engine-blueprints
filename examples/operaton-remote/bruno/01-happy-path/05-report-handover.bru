meta {
  name: Report the handover
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/api/bike-leasing/{{applicationId}}/report-handover
  body: none
  auth: none
}

script:pre-request {
  const id = bru.getVar('applicationId');
  const pid = bru.getVar('processInstanceId');
  await pollApp(`/api/bike-leasing/${id}`, (b, s) => s === 200 && b && b.status === "ORDERED" && b.orderId != null);
  await pollEngine(`/event-subscription?processInstanceId=${pid}&eventType=message&eventName=miravelo.handoverReported`,
    (b) => Array.isArray(b) && b.length >= 1);
}

assert {
  res.status: eq 202
}
