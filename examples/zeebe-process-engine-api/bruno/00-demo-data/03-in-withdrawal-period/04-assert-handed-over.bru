meta {
  name: Assert the application is HANDED_OVER
  type: http
  seq: 4
  tags: [
    demo-data
  ]
}

get {
  url: {{baseUrl}}/api/bike-leasing/{{applicationId}}
  body: none
  auth: none
}

script:pre-request {
  const id = bru.getVar("applicationId");
  await pollApp(`/api/bike-leasing/${id}`, (b, s) => s === 200 && b && b.status === "HANDED_OVER");
}

assert {
  res.status: eq 200
  res.body.status: eq HANDED_OVER
}
