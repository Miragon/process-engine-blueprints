meta {
  name: Report the handover
  type: http
  seq: 3
  tags: [
    demo-data
  ]
}

post {
  url: {{baseUrl}}/api/bike-leasing/{{applicationId}}/report-handover
  body: none
  auth: none
}

script:pre-request {
  await pollApp("/api/bike-leasing/" + bru.getVar("applicationId"),
    (b, s) => s === 200 && b && b.status === "ORDERED" && b.orderId != null);
  await pollEngine("/execution?businessKey=" + bru.getVar("applicationId")
    + "&messageEventSubscriptionName=miravelo.handoverReported",
    (b) => Array.isArray(b) && b.length >= 1);
}

assert {
  res.status: eq 202
}
