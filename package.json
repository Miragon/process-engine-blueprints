{
  "name": "process-engine-blueprints-tooling",
  "version": "1.0.0",
  "private": true,
  "description": "Maintainer tooling of the monorepo: generates the root CI, Dependabot, README matrix, Conductor targets and the starter catalog from examples/*/blueprint.yaml, and checks drift between the examples.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "generate": "node scripts/generate.mjs",
    "generate:check": "node scripts/generate.mjs --check",
    "drift": "node scripts/check-drift.mjs",
    "test": "node --test \"tooling/create-blueprint/test/*.test.mjs\" \"scripts/test/*.test.mjs\"",
    "hooks:install": "git config core.hooksPath .githooks"
  },
  "devDependencies": {
    "smol-toml": "1.9.1",
    "yaml": "2.9.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/miragon-blueprints/process-engine-blueprints.git"
  }
}
